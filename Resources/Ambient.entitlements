<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Select the terminal tab an agent runs in (Terminal, iTerm2) when you click its notification. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<!-- Record a voice for another Mac, only while the voice shortcut is recording. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- Show your next event today on the living wallpaper. -->
	<key>com.apple.security.personal-information.calendars</key>
	<true/>
</dict>
</plist>
